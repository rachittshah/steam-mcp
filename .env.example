# Steam Web API key. Get one at https://steamcommunity.com/dev/apikey
# Required for most ISteamUser / IPlayerService / ISteamUserStats tools.
# Store tools (app details, reviews, search) work without a key.
STEAM_API_KEY=

# Optional: request timeout in seconds (default: 20)
STEAM_MCP_TIMEOUT=20

# Optional: default language for store/localized responses (default: english)
STEAM_MCP_LANGUAGE=english

# Optional: default country code (ISO 3166-1) for store pricing (default: US)
STEAM_MCP_COUNTRY=US
